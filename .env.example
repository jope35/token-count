# Copy this file to .env and fill in the values. .env is gitignored.
# Process environment variables win over this file. All keys are optional:
# a missing key is reported per model as "missing key <ENV>" and never
# aborts a run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
Z_AI_API_KEY=
MOONSHOT_API_KEY=
